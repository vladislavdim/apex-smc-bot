# Optional self-hosted adapters. Leave unset: public futures fallback continues.
CRYPTO_MONITOR_API_URL=
CRYPTO_MONITOR_API_KEY=
WHALE_TRACKER_API_URL=
WHALE_TRACKER_API_KEY=

# Reserved for a documented private DeepBlueAlpha deployment. The bot does not
# guess private endpoints. The keyless public token top-20 API is used
# automatically for pairs that appear in its 1H/24H ranking.
SMART_MONEY_API_URL=
SMART_MONEY_API_KEY=

# Optional verified labels; addresses are never guessed.
OLI_API_URL=https://api.openlabelsinitiative.org
OLI_API_KEY=
OLI_TRACKED_ADDRESSES_JSON={}
# Verified contracts only; symbols are never resolved by ticker guessing.
# Format: {"LINKUSDT":{"chain":"ethereum","address":"0x..."}}
ASSET_CONTRACT_MAP_JSON={}
# Optional Coin Metrics aliases when an APEX ticker differs from the canonical
# Community API asset slug, for example {"1000PEPEUSDT":"pepe"}.
COINMETRICS_ASSET_MAP_JSON={}

# Unified final quality gate. Defaults are shown; no extra key is required for
# the public Fair Economy calendar or crypto RSS feeds.
MACRO_CALENDAR_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODELS=openai/gpt-oss-120b
GROQ_MIN_APPROVAL_CONFIDENCE=0.65
CLOSED_LOOP_MIN_SAMPLES=12
NEW_STRATEGY_MIN_CLOSED_TRADES=30

# Optional order execution. Safe defaults make no exchange requests and place
# no orders. Start with paper mode; live requires BOTH the enabled/mode flags
# and the exact confirmation phrase below. Never commit real credentials.
AUTO_TRADING_ENABLED=false
AUTO_TRADING_MODE=paper
AUTO_TRADING_PAPER_BALANCE_USDT=1000
AUTO_TRADING_RISK_PCT=0.5
AUTO_TRADING_LEVERAGE=5
AUTO_TRADING_TP1_FRACTION=0.5
AUTO_TRADING_FEE_BPS=10
AUTO_TRADING_TIMEOUT_SECONDS=8
AUTO_TRADING_RETRIES=3
AUTO_TRADING_MIN_GROQ_CONFIDENCE=0.70
# Emergency stop: true prevents every new live order without changing signals.
AUTO_TRADING_KILL_SWITCH=false
AUTO_TRADING_MAX_OPEN_POSITIONS=3
AUTO_TRADING_MAX_DAILY_LOSS_PCT=2.0
BINANCE_FUTURES_API_URL=https://fapi.binance.com
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Required verbatim only when deliberately switching AUTO_TRADING_MODE=live:
AUTO_TRADING_LIVE_CONFIRM=

# Database snapshots are written to this dedicated GitHub branch, never main.
BRAIN_BACKUP_BRANCH=brain-backups
